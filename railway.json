{
  "name": "centerline-tracing-web-app",
  "buildScript": "pip install -r requirements.txt",
  "startCommand": "gunicorn --workers 1 --threads 8 --timeout 300 --bind 0.0.0.0:$PORT centerline_web_app:app",
  "environment": "python",
  "python": {
    "version": "3.11"
  },
  "healthCheck": {
    "port": 5000,
    "path": "/"
  }
}
